bility\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"router\",\"type\":\"address\"}],\"name\":\"setSwapRouter\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"swapRouter\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"next\",\"type\":\"address\"}],\"name\":\"transferOwnership\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"usdc\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"The burn target is `$EVE` and is fixed at construction. It was previously a one-shot      `setArcfun` setter, which existed only because the protocol token did not exist yet when      this was written. It does now (`0x19209E55049bc613c5cC8b66B7DF7824096e78CF`), so the      setter is gone: an immutable cannot be pointed at the wrong token by a mistaken or      compromised owner call, and there is no window in which USDC accrues against an unset      target. Same shape as EveBurn. Use `cookPaused` to stop cooking.      cook is never called from collect; a keeper passes minOut.\",\"kind\":\"dev\",\"methods\":{},\"title\":\"Crucible\",\"version\":1},\"userdoc\":{\"events\":{\"Burn(address,uint256,uint256,uint256)\":{\"notice\":\"Burn tape row. `token` is the ARCFUN that was bought and sent to dead.\"}},\"kind\":\"user\",\"methods\":{\"cook(uint256,uint256)\":{\"notice\":\"Permissionless. Swaps `amountIn` USDC for ARCFUN and sends it to dead.         Reverts while cook is paused. `amountIn == 0` is a no-op.         `minEveOut` must be > 0 when swapping; there is no zero-slippage overload.\"},\"keepers(address)\":{\"notice\":\"Addresses allowed to execute the swap. The owner is always allowed.\"},\"setEvePoolFee(uint24)\":{\"notice\":\"One-shot. Points the burn target. Cannot unset or repoint.\"},\"setSwapRouter(address)\":{\"notice\":\"Rotate the router and revoke the old one's USDC allowance.\"}},\"notice\":\"Holds quote-side Crucible USDC and cooks it: USDC \\u2192 `$EVE` on SwapRouter02,         `$EVE` to `0x\\u2026dead`. Burn tape event is `Burn`.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/Crucible.sol\":\"Crucible\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"appendCBOR\":false,\"bytecodeHash\":\"none\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@openzeppelin/contracts-upgradeable/=/Users/hex/Downloads/Arcfun/contracts/arc-nft/lib/openzeppelin-contracts-upgradeable/contracts/\",\":@openzeppelin/contracts/=/Users/hex/Downloads/Arcfun/contracts/arc-nft/lib/openzeppelin-contracts/contracts/\",\":erc4626-tests/=/Users/hex/Downloads/Arcfun/contracts/arc-nft/lib/openzeppelin-contracts-upgradeable/lib/erc4626-tests/\",\":forge-std/=lib/forge-std/src/\",\":halmos-cheatcodes/=/Users/hex/Downloads/Arcfun/contracts/arc-nft/lib/openzeppelin-contracts-upgradeable/lib/halmos-cheatcodes/src/\",\":openzeppelin-contracts-upgradeable/=/Users/hex/Downloads/Arcfun/contracts/arc-nft/lib/openzeppelin-contracts-upgradeable/contracts/\",\":openzeppelin-contracts/=/Users/hex/Downloads/Arcfun/contracts/arc-nft/lib/openzeppelin-contracts/contracts/\"]},\"sources\":{\"src/Crucible.sol\":{\"keccak256\":\"0x6c8c3a036d3950f4cab5dd6a98bd96b89a6605afd578a2ccb0971fc6e501ee37\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://6cb60846d8e0fce4020b68ce9588cdd8ec9af7445aebd2c0892721b1049673fd\",\"dweb:/ipfs/QmZeicgkGXyVf62UUTdfL8Q178amZLruQMeZSZdxabYxRy\"]},\"src/interfaces/IERC20Minimal.sol\":{\"keccak256\":\"0x654d62bd84c31aa1baa92d0466f34bbf4a1b21fa63246f64ac44ce6221810d5d\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://04fc249f27e61c47ee4b5f8ed80381c75495b77182c1c0868dfde916ad36fca9\",\"dweb:/ipfs/QmXsVq3MZfCo13eigJHFUYkzxsLZdYUG6s1ELCLDdQfMnQ\"]