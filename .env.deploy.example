# =============================================================================
# ArcFun contract deploy secrets — COPY to `.env.deploy` and fill in.
#
#   cp .env.deploy.example .env.deploy
#   # edit .env.deploy  (gitignored — never commit)
#
# Used by Foundry scripts in robots-merge (or robots):
#   contracts/monad-launchpad/script/DeployInstantUsdcArc.s.sol
#   contracts/monad-launchpad/script/DeployRobinFeeRouterArc.s.sol
#
# Do NOT put PRIVATE_KEY in `.env.local` (that file is for the Next.js app and
# can leak into client bundles if you prefix with NEXT_PUBLIC_).
# =============================================================================

# --- Chain / RPC (Arc mainnet 5042) ---
# Prefer Infura with Arc enabled. Public baracat works for reads; deploys need a
# reliable eth_sendRawTransaction endpoint.
ARC_RPC_URL=https://arc-mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
# Optional aliases some scripts / forge flags use:
# RPC_URL=
# ETH_RPC_URL=

# --- Deployer key (required) ---
# Hex private key of the wallet that pays gas and (usually) becomes platform owner.
# Foundry accepts with or without 0x prefix. NEVER share this in chat.
PRIVATE_KEY=

# Same key under an alternate name if you prefer (upgrade scripts accept either):
# PLATFORM_PRIVATE_KEY=

# --- Platform economics (optional — default = deployer address derived from PRIVATE_KEY) ---
# Set these if the owner / treasury should be a DIFFERENT address than the key that deploys.
# Most ArcFun setups: leave blank so deployer == OWNER == TREASURY == LP_RECIPIENT.
OWNER=
TREASURY=
LP_RECIPIENT=
# Staker-leg fee sink (no OFun staking on Arc yet — defaults to TREASURY)
STAKING_POOL=
# RobinFeeRouter fee skim recipient (defaults to deployer)
FEE_RECIPIENT=

# --- Instant pad params (optional — script defaults are fine for first deploy) ---
# Native USDC 18dp creation fee. 1e17 = 0.1 USDC. 0 = free creates.
CREATION_FEE_WEI=100000000000000000
# Virtual quote for launch FDV (USDC 6dp). Default in script: 5500000000 (= $5,500 → ~$5.2k FDV)
LAUNCH_VIRTUAL_QUOTE=5500000000
# LP lock duration in seconds (default 365 days)
LOCK_DURATION=31536000
# Meme LP fee split: creator bps / staker bps of the non-platform leg. 7000/0 = 70% creator / 30% platform
MEME_CREATOR_BPS=7000
MEME_STAKER_BPS=0
# RobinFeeRouter swap skim (bps). 100 = 1%
FEE_BPS=100

# --- After deploy: paste addresses here so we can wire ArcFun frontend ---
# (scripts print these; fill them in after broadcast succeeds)
NEXT_PUBLIC_ARC_INSTANT_FACTORY=
NEXT_PUBLIC_ARC_INSTANT_LOCKER=
NEXT_PUBLIC_ARC_BPS_SOURCE=
NEXT_PUBLIC_ARC_FEE_ROUTER=
# Factory ProxyAdmin + Locker ProxyAdmin (from broadcast logs / explorer — needed for upgrades)
ARC_FACTORY_PROXY_ADMIN=
ARC_LOCKER_PROXY_ADMIN=
# Explicit platform wallet the app treats as fee-waived on create
NEXT_PUBLIC_ARC_PLATFORM_WALLET=
# Public Meme + Reflection creates (1/unset = open, 0 = all cards "Soon")
NEXT_PUBLIC_ARC_LAUNCHES_ENABLED=1
