# ArcFun — environment variables
# Copy to .env.local for dev, and set the same keys in Vercel → Settings → Environment Variables
# for Production. See README.md for the full go-live runbook.

# --- Site ---
NEXT_PUBLIC_APP_URL=https://arcfun.lol
NEXT_PUBLIC_SITE_URL=https://arcfun.lol

# --- Arc chain (mainnet 5042) ---
NEXT_PUBLIC_ARC_ENABLED=1
# Public Meme + Reflection creates. Default on; set to 0 to show all launch cards as "Soon".
NEXT_PUBLIC_ARC_LAUNCHES_ENABLED=1
NEXT_PUBLIC_ARC_CHAIN_ID=5042
# Browser RPC: public endpoints only. Do not put an Infura /v3/ key here (it ships in the JS bundle).
# Leave unset to use baracat + theleak + arc-scan (baked into lib/contracts-arc.ts).
NEXT_PUBLIC_ARC_RPC=
NEXT_PUBLIC_ARC_RPC_FALLBACKS=
NEXT_PUBLIC_ARC_EXPLORER=https://arc-scan.org

# Server-only Infura (enable Arc on the Infura project). Never prefix with NEXT_PUBLIC_.
INFURA_API_KEY=
# Optional full server RPC override (can be Infura). Fallbacks still apply.
ARC_RPC=

# Live Robinpad-on-Arc Instant contracts (reused as-is — see docs; redeploy your own if you
# want a fully independent fee treasury instead of Robinpad's).
NEXT_PUBLIC_ARC_INSTANT_FACTORY=0x6D7621997D8cF3b5d2d191cd014324149211Af93
NEXT_PUBLIC_ARC_INSTANT_LOCKER=0x9aB2C774b317C11B69c0A316B47cA8d90b805a9C
NEXT_PUBLIC_ARC_BPS_SOURCE=0x12239B4593b143838b0ceb55Bc8A4150946E45Ed
NEXT_PUBLIC_ARC_FEE_ROUTER=0x8d051f7FCf2F67f272b6ec96dAf2e9a847633394

# Uniswap V3 canonical deployment on Arc (hardcoded defaults in lib/contracts-arc.ts; override optional)
NEXT_PUBLIC_ARC_UNI_FACTORY=0xf0db7b58379503491d857dB50AC9ece64c653918
NEXT_PUBLIC_ARC_UNI_NFPM=0x39654a85a4c05127f5fd6ed22caec077a0fb1377
NEXT_PUBLIC_ARC_UNI_ROUTER=0x53bf6b0684ec7ef91e1387da3d1a1769bc5a6f77
NEXT_PUBLIC_ARC_UNI_QUOTER=0x7dfd4f31be6814d2906bde155c3e1b146eac1468
NEXT_PUBLIC_ARC_WETH=0x8bcEaA40B9AcdfAedF85AdF4FF01F5Ad6517937f

# --- Storage (Vercel KV) — provision a NEW/separate KV store for ArcFun, do not share Robinpad's ---
# Dedicated ArcFun store (do NOT reuse Robinpad's). Create via Vercel → Storage →
# Upstash Redis, or Upstash console, then paste REST credentials here.
# @vercel/kv accepts either KV_* or UPSTASH_* names.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# --- Wallet connect (get your own project id at cloud.reown.com; do not reuse Robinpad's) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Image uploads (Vercel Blob, public store `arcfun-images`) ---
# Connected in the Vercel dashboard. Production injects BLOB_READ_WRITE_TOKEN / BLOB_STORE_ID.
# Do not commit those values. Existing Cloudinary URLs in metadata keep working.
NEXT_PUBLIC_ARC_PLATFORM_WALLET=
# Instant Reflection (set after DeployInstantReflectionArc.s.sol)
NEXT_PUBLIC_ARC_REFLECTION_FACTORY=0xa4957E724696b740b323fF3536415bB945e46828
NEXT_PUBLIC_ARC_REFLECTION_LOCKER=0x20647d9cA81d31f0624aB9912eAf51892d62c24F

# Blitz launch live watch (optional). Paste-a-tweet works without this.
# X API v2 app bearer. Never NEXT_PUBLIC_.
X_BEARER_TOKEN=

# ArcPort NFT factory (UUPS proxy on 5042). Hardcoded default in lib/contracts-arc.ts.
NEXT_PUBLIC_ARCPORT_FACTORY=0x0b7aD72020BDF5efECac11890DA8646f1339307e
NEXT_PUBLIC_ARC_DISPERSE=0xE13D582882008A18e78ABEC0B68Cbe0e0fE25c46
0x26bD491560b5175ee8bD1DA4998Fe260FfC413c9

# ── x402 agent payments on /api/mcp (OFF by default) ────────────────────────
# Charges agents per paid tool call in Arc USDC via EIP-3009 transferWithAuthorization.
# Discovery (initialize / tools/list / the `about` tool) is always free.
# Requires ARC_OTC_KEEPER_KEY — the keeper broadcasts settlement and pays the gas, so the
# paying agent needs USDC but no native gas. Leave X402_ENABLED unset to keep the MCP venue free.
X402_ENABLED=
# Wallet that receives payments (required when enabled).
X402_PAY_TO=
# Price per paid call in atomic USDC (6dp). 1000 = $0.001. Defaults to 1000 if unset.
X402_PRICE_ATOMIC=1000
