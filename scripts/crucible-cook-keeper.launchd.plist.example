<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template only — NOT installed by anything in this repo, and deliberately DOES NOT pass --live.
  This moves real funds (buys $EVE with the Crucible sink's accrued USDC and burns it) — watch it
  run unattended in dry-run mode for a while first and read its log output before you add --live
  to ProgramArguments below. There is no undo on a live cook() once it's sent.

  If you decide to run crucible-cook-keeper.ts unattended, copy this to
  ~/Library/LaunchAgents/co.arcfun.crucible-cook-keeper.plist, fill in the two ABSOLUTE PATHS
  below, put CRUCIBLE_KEEPER_PRIVATE_KEY in .env.local (a DEDICATED keeper key — see the script's
  own header comment for why not the platform wallet), then:

    launchctl load ~/Library/LaunchAgents/co.arcfun.crucible-cook-keeper.plist

  KeepAlive restarts it if it crashes; RunAtLoad starts it on login. It does NOT survive the Mac
  being asleep — pair with `caffeinate -i` or `pmset` if you want it to keep running with the lid
  closed. StandardOutPath/StandardErrorPath give you a log file, since a launchd process has no
  visible terminal to watch — and since this handles money, that log is the audit trail.

  To stop it: launchctl unload ~/Library/LaunchAgents/co.arcfun.crucible-cook-keeper.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>co.arcfun.crucible-cook-keeper</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>npx</string>
    <string>tsx</string>
    <string>--env-file=.env.local</string>
    <string>scripts/crucible-cook-keeper.ts</string>
    <!-- Dry run until you've watched it behave correctly. Add this line once you're confident: -->
    <!-- <string>--live</string> -->
  </array>

  <!-- REQUIRED: absolute path to your Arcfun checkout -->
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/path/to/Arcfun</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- REQUIRED: absolute paths for log output -->
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/path/to/Arcfun/scripts/crucible-cook-keeper.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/path/to/Arcfun/scripts/crucible-cook-keeper.error.log</string>
</dict>
</plist>
